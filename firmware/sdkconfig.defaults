# sdkconfig.defaults — vc-quaternions (ESP32-S3, Waveshare ESP32-S3-LCD-1.28)
# ESP-IDF >= 5.1 required (esp_lcd + NimBLE).

CONFIG_IDF_TARGET="esp32s3"

# CPU frequency: 240 MHz (default on ESP32-S3)
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_XTAL_FREQ_40=y

# PSRAM: 2 MB Octal PSRAM (onboard the Waveshare board)
CONFIG_ESP32_S3_SDKCONFIG_DEFAULTS_PS2MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SDKCONFIG=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# Flash size: 16 MB (onboard W25Q128)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Partition table: 0x90000 app + 0x70000 OTA
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_PARTITION_PARTADDR=0x90000
CONFIG_ESP_PARTITION_APP_DEFAULT_PARTADDR=0x90000
CONFIG_ESP_PARTITION_OTA_0_PARTADDR=0xF0000

# Serial flasher config
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART="UART0"
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_ITU_RATE=y
CONFIG_BT_NIMBLE_DEBUG=NIMBLE_DEBUG_OFF
CONFIG_BT_NIMBLE_MAX_STATES=1
CONFIG_BT_NIMBLE_SM_IO_CAPS=BLE_HS_IO_NO_INPUT_OUTPUT
CONFIG_BT_NIMBLE_SM_SC=y

# LCD / SPI
CONFIG_ESP_LCD_PANEL_IO_SPI=y
CONFIG_ESP_LCD_PANEL_VENDOR_GC9A01=y
CONFIG_ESP_LCD_PANEL_RGB=n

# Task priorities / stack (ESP32-S3: stack in words)
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_tick_rate_hz=1000
CONFIG_FREERTOS_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_MAX_TASK_NAME_LEN=32

# NXP-style low-power tickless (optional, for deep-sleep)
CONFIG_FREERTOSTickFrequency=1000
